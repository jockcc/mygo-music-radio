{
  "id": "radio",
  "name": "Radio",
  "version": "0.1.0",
  "minAppVersion": "0.1.20",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "*.radio-browser.info"
    ]
  },
  "settings": [
    {
      "key": "mirror",
      "label": "Server",
      "help": "Leave empty to pick the fastest mirror. Such as de1.api.radio-browser.info",
      "link": "https://api.radio-browser.info/"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "stations"
    },
    {
      "title": "All stations",
      "page": "all",
      "icon": "radio"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "Recently played",
      "page": "recent",
      "icon": "calendar"
    }
  ]
}
